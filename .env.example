# Hotel Management / POS — Environment Template
# Copy to .env.local and fill real values. Never commit .env.local.
# See lib/sessionCrypto.js (AUTH_SECRET required in production) and lib/mongodb.js

# MongoDB — Atlas SRV URI for unified hotel_management database (orders + menu)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/hotel_management?retryWrites=true&w=majority
# Legacy alias kept for compat (same value as MONGODB_URI)
CAFEDB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/hotel_management?retryWrites=true&w=majority

# Session — HMAC-SHA256 signing secret for HttpOnly bono_sess cookie
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production (lib/sessionCrypto throws if missing with NODE_ENV=production)
AUTH_SECRET=change-me-to-64-hex-chars-minimum

# Cloudinary — menu/brand image CDN (server-side secret never exposed to client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: additional allowed CORS origins (comma-separated). Same-origin is always allowed.
# ALLOWED_ORIGINS=https://admin.example.com,https://pos.example.com
